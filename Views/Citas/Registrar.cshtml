
@model HuellitasFelices.Models.Cita

@{
    ViewData["Title"] = "Solicitar cita";
}

<div class="container py-5">
    <div class="text-center mb-4">
        <h1 class="fw-bold">Agenda una cita 🐾</h1>
        <p class="text-muted">
            Cuéntanos sobre tu mascota y nosotros nos encargamos del resto.
        </p>
    </div>

    <div class="card shadow-sm mx-auto" style="max-width: 650px;">
        <div class="card-body p-4">

            <form asp-controller="Citas"
                  asp-action="Registrar"
                  method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="NombrePropietario"
                           class="form-label">Nombre del propietario</label>
                    <input asp-for="NombrePropietario"
                           class="form-control"
                           placeholder="Tu nombre completo" />
                    <span asp-validation-for="NombrePropietario"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="NombreMascota"
                           class="form-label">Nombre de la mascota</label>
                    <input asp-for="NombreMascota"
                           class="form-control"
                           placeholder="Nombre de tu mascota" />
                    <span asp-validation-for="NombreMascota"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Especie"
                           class="form-label">Tipo de mascota</label>
                    <select asp-for="Especie" class="form-select">
                        <option value="">Selecciona una opción</option>
                        <option value="Perro">Perro</option>
                        <option value="Gato">Gato</option>
                        <option value="Otro">Otro</option>
                    </select>
                    <span asp-validation-for="Especie"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Servicio"
                           class="form-label">Servicio solicitado</label>
                    <select asp-for="Servicio" class="form-select">
                        <option value="">Selecciona un servicio</option>
                        <option value="Consulta veterinaria">Consulta veterinaria</option>
                        <option value="Baño">Baño</option>
                        <option value="Peluquería">Peluquería</option>
                        <option value="Vacunación">Vacunación</option>
                    </select>
                    <span asp-validation-for="Servicio"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Telefono"
                           class="form-label">Teléfono de contacto</label>
                    <input asp-for="Telefono"
                           class="form-control"
                           placeholder="Número de teléfono" />
                    <span asp-validation-for="Telefono"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Fecha"
                           class="form-label">Fecha de la cita</label>
                    <input asp-for="Fecha"
                           type="date"
                           asp-format="{0:yyyy-MM-dd}"
                           class="form-control" />
                    <span asp-validation-for="Fecha"
                          class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Observaciones"
                           class="form-label">Observaciones</label>
                    <textarea asp-for="Observaciones"
                              class="form-control"
                              rows="3"
                              placeholder="¿Algo que debamos saber?"></textarea>
                </div>

                <button type="submit"
                        class="btn btn-success w-100">
                    Solicitar cita
                </button>

            </form>
        </div>
    </div>
</div>
