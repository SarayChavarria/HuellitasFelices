
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Huellitas Felices</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
</head>

<body>

    <nav class="navbar navbar-expand-md navbar-dark barra-navegacion sticky-top">
        <div class="container">

            <a class="navbar-brand fw-bold"
               asp-controller="Home"
               asp-action="Index">
                🐾 Huellitas Felices
            </a>

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#menuPrincipal">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="menuPrincipal">

                <div class="navbar-nav ms-auto">

                    <a class="nav-link"
                       asp-controller="Home"
                       asp-action="Index">
                        Inicio
                    </a>

                    <a class="nav-link"
                       asp-controller="Citas"
                       asp-action="Registrar">
                        Solicitar cita
                    </a>

                    <a class="nav-link"
                       asp-controller="Citas"
                       asp-action="Index">
                        Ver citas
                    </a>

                    <a class="nav-link"
                       asp-controller="Home"
                       asp-action="Index"
                       asp-fragment="horarios">
                        Horarios
                    </a>
                    
                    <a class="nav-link"
                    asp-controller="Productos"
                    asp-action="Index">
                        Productos
                    </a>

                </div>
            </div>
        </div>
    </nav>

    <main>
        @RenderBody()
    </main>

    <footer class="pie-pagina text-center py-4 mt-5">
        <div class="container">
            <p class="fw-bold mb-1">🐾 Huellitas Felices</p>
            <p class="mb-0">
                © 2026 Huellitas Felices. Todos los derechos reservados.
            </p>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
