
@{
    ViewData["Title"] = "Mi carrito";
}

<div class="container py-5">

    <div class="text-center mb-5">
        <p class="texto-superior mb-1">TU COMPRA</p>

        <h1 class="titulo-seccion">
            Mi carrito 🛒
        </h1>

        <p class="text-secondary">
            Revisa los productos que elegiste para tus mascotas.
        </p>
    </div>

    <div class="card shadow-sm">

        <div class="card-body p-4">

            <div id="carrito-vacio" class="text-center py-4">
                <h4>Tu carrito está vacío 🐾</h4>

                <p class="text-secondary">
                    ¡Agrega algunos productos para tus mascotas!
                </p>

                <a asp-controller="Productos"
                   asp-action="Index"
                   class="btn btn-principal">
                    Ir a productos
                </a>
            </div>

            <div id="contenido-carrito" style="display: none;">

                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-success">
                            <tr>
                                <th>Producto</th>
                                <th>Precio</th>
                                <th>Cantidad</th>
                                <th>Subtotal</th>
                                <th>Acción</th>
                            </tr>
                        </thead>

                        <tbody id="tabla-carrito">
                        </tbody>

                    </table>

                </div>

                <div class="resumen-carrito rounded p-3 text-end">

                    <h4>
                        Total:
                        <span id="total-carrito">$0</span> COP
                    </h4>

                </div>

                <div class="d-flex justify-content-between flex-wrap gap-2 mt-4">

                    <a asp-controller="Productos"
                       asp-action="Index"
                       class="btn btn-outline-success">
                        Seguir comprando
                    </a>

                    <button type="button"
                            id="vaciar-carrito"
                            class="btn btn-outline-danger">
                        Vaciar carrito
                    </button>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts {
    <script src="~/js/carrito-pagina.js" asp-append-version="true"></script>
}
