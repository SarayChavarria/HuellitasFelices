
@model IEnumerable<HuellitasFelices.Models.Producto>

@{
    ViewData["Title"] = "Catálogo de productos";
}

<div class="container py-5">

    <div class="text-center mb-5">
        <p class="texto-superior mb-1">NUESTRA TIENDA</p>

        <h1 class="titulo-seccion">
            Productos para tus mascotas 🐾
        </h1>

        <p class="text-secondary">
            Encuentra todo lo que necesitas para cuidar
            y consentir a tus mejores amigos.
        </p>
    </div>

    <div class="d-flex justify-content-center flex-wrap gap-2 mb-5">

        <a asp-controller="Productos"
           asp-action="Index"
           class="btn btn-principal">
            Todos
        </a>

        <a asp-controller="Productos"
           asp-action="Index"
           asp-route-categoria="Alimentos"
           class="btn btn-outline-success">
            Alimentos
        </a>

        <a asp-controller="Productos"
           asp-action="Index"
           asp-route-categoria="Accesorios"
           class="btn btn-outline-success">
            Accesorios
        </a>

        <a asp-controller="Productos"
           asp-action="Index"
           asp-route-categoria="Juguetes"
           class="btn btn-outline-success">
            Juguetes
        </a>

        <a asp-controller="Productos"
           asp-action="Index"
           asp-route-categoria="Higiene"
           class="btn btn-outline-success">
            Higiene
        </a>

    </div>

    <div class="row g-4">

        @foreach (var producto in Model)
        {
            <div class="col-12 col-sm-6 col-lg-4">

                <div class="card tarjeta-producto">

                    <div class="icono-producto">
                        @producto.Imagen
                    </div>

                    <div class="card-body d-flex flex-column">

                        <span class="badge bg-success-subtle text-success mb-2">
                            @producto.Categoria
                        </span>

                        <h5 class="card-title fw-bold">
                            @producto.Nombre
                        </h5>

                        <p class="card-text text-secondary">
                            @producto.Descripcion
                        </p>

                        <p class="precio-producto">
                            $@producto.Precio.ToString("N0") COP
                        </p>

                        <p class="text-muted small">
                            Unidades disponibles: @producto.Stock
                        </p>

                    </div>

                </div>

            </div>
        }

    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center mt-4">
            No hay productos disponibles en esta categoría.
        </div>
    }

</div>
